# This file managed by Ansible

# Ubuntu logs are commonly under root:adm group-writable directories.
# Specify rotation credentials instead of skipping them as insecure.
su root adm

# rotate log files {{ logrotate_frequency }}
{{ logrotate_frequency }}

# keep {{ logrotate_keep }} rotated logs
rotate {{ logrotate_keep }}

# create new (empty) log files after rotating old ones
create

{% if logrotate_compress %}
# compress old log files
compress
{% endif %}

# packages drop log rotation information into this directory
include /etc/logrotate.d
