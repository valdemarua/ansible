[Unit]
Description=Restrict the Dokploy dashboard port in DOCKER-USER
After=docker.service
Requires=docker.service
# Re-apply whenever Docker restarts, since Docker rebuilds its chains.
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/dokploy-firewall

[Install]
WantedBy=multi-user.target
