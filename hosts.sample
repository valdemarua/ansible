[dokploy_servers]
your-dokploy-server.com ansible_user=deploy ansible_become=yes

[k3s_servers]
your-k3s-server.com ansible_user=deploy ansible_become=yes

# Servers that only need the base playbook
[base_servers]
your-base-server.com ansible_user=deploy ansible_become=yes

[devboxes]
# Override admin_user_name per host when you prefer a different account:
# your-custom-devbox.com ansible_user=admin admin_user_name=admin ansible_become=yes
your-devbox.com ansible_user=dev ansible_become=yes

# Local test VM — run bin/vm-setup to create and populate hosts.local
[test]
# 192.168.64.x  ansible_user=deploy ansible_become=yes

[all:vars]
# Add your public keys when using this as a standalone inventory file.
# For private inventory directories, prefer group_vars/all.yml instead.
# admin_user_ssh_keys=["ssh-ed25519 AAAA... your-key"]
